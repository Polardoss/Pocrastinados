# Copy this file to .env.local for local development and fill in real
# values. Never commit .env.local (it is gitignored). For deployment, set
# the same variables in the Vercel project settings instead.

# --- Supabase ---------------------------------------------------------------
# Project Settings > API in your Supabase dashboard.
SUPABASE_URL=
# The "service_role" secret key (NOT the anon/public key). Server-side only —
# never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Steam --------------------------------------------------------------
# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# Your 64-bit SteamID (e.g. via https://steamid.io/)
STEAM_ID64=

# --- Vercel Cron ---------------------------------------------------------
# Random secret used to authorize calls to /api/cron/steam and
# /api/cron/trakt. Vercel automatically sends it as
# `Authorization: Bearer <CRON_SECRET>` when triggering configured cron jobs
# (see vercel.json). Generate one with:
#   openssl rand -hex 32
CRON_SECRET=

# --- Trakt.tv -------------------------------------------------------------
# Register an app at https://trakt.tv/oauth/applications (redirect URI
# doesn't matter, the device code flow below doesn't use it).
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
# No refresh token env var needed: after setting the two values above, run
# `npm run trakt:authorize` once — it stores the access/refresh token pair
# in Supabase (trakt_tokens) and keeps them refreshed automatically.

# --- YouTube ingestion ------------------------------------------------------
# Shared secret the Chrome extension (extension/) sends as a Bearer token to
# authenticate calls to /api/ingest/youtube. Generate one with:
#   openssl rand -hex 32
# and paste the same value into the extension's options page.
YOUTUBE_INGEST_SECRET=
