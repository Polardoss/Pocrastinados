# Copy this file to .env.local for local development and fill in real
# values. Never commit .env.local (it is gitignored). For deployment, set
# the same variables in the Vercel project settings instead.

# --- Supabase ---------------------------------------------------------------
# Project Settings > API in your Supabase dashboard.
SUPABASE_URL=
# The "service_role" secret key (NOT the anon/public key). Server-side only —
# never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Steam --------------------------------------------------------------
# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# Your 64-bit SteamID (e.g. via https://steamid.io/)
STEAM_ID64=

# --- Vercel Cron ---------------------------------------------------------
# Random secret used to authorize calls to /api/cron/steam. Vercel
# automatically sends it as `Authorization: Bearer <CRON_SECRET>` when
# triggering configured cron jobs (see vercel.json). Generate one with:
#   openssl rand -hex 32
CRON_SECRET=

# --- Trakt.tv (added when Trakt integration is implemented) ----------------
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
TRAKT_REFRESH_TOKEN=

# --- YouTube ingestion (added when the extension ingestion endpoint ships) --
# Shared secret the Chrome extension sends to authenticate ingestion requests.
YOUTUBE_INGEST_SECRET=
